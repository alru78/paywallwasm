{
  "id": "paywallwasm",
  "name": "Paywall",
  "short_description": "Unlock a link after a Lightning payment.",
  "version": "0.1.5",
  "min_lnbits_version": "1.7.1",
  "extension_type": "wasm",
  "contributors": [
    {
      "name": "alru78",
      "uri": "https://github.com/alru78",
      "role": "Developer"
    },
    {
      "name": "eillarra",
      "uri": "https://github.com/eillarra",
      "role": "Original Paywall extension"
    }
  ],
  "license": "MIT",
  "description_md": "https://raw.githubusercontent.com/alru78/paywallwasm/main/description.md",
  "images": [
    {
      "uri": "https://raw.githubusercontent.com/alru78/paywallwasm/main/images/gallery-1.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/alru78/paywallwasm/main/images/gallery-2.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/alru78/paywallwasm/main/images/gallery-3.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/alru78/paywallwasm/main/images/gallery-4.png"
    },
    {
      "uri": "https://raw.githubusercontent.com/alru78/paywallwasm/main/images/gallery-5.png"
    }
  ],
  "wasm": {
    "module": "wasm/module.wasm",
    "exports": [
      {
        "name": "create-paywall",
        "visibility": "authenticated"
      },
      {
        "name": "update-paywall",
        "visibility": "authenticated"
      },
      {
        "name": "list-paywalls",
        "visibility": "authenticated"
      },
      {
        "name": "delete-paywall",
        "visibility": "authenticated"
      },
      {
        "name": "list-paywall-payments",
        "visibility": "authenticated"
      },
      {
        "name": "list-wallets",
        "visibility": "authenticated"
      },
      {
        "name": "list-currencies",
        "visibility": "public"
      },
      {
        "name": "get-public-paywall",
        "visibility": "public"
      },
      {
        "name": "create-paywall-invoice",
        "visibility": "public"
      },
      {
        "name": "check-paywall-payment",
        "visibility": "public"
      },
      {
        "name": "record-payment",
        "visibility": "event"
      }
    ]
  },
  "events": {
    "onInvoicePaid": "record-payment"
  },
  "ui_routes": [
    {
      "path": "/paywallwasm",
      "entrypoint": "ui/admin.html",
      "auth": "user"
    },
    {
      "path": "/paywallwasm/{paywall_id}",
      "entrypoint": "ui/public.html",
      "auth": "public",
      "path_params": {
        "paywall_id": "paywallId"
      }
    }
  ],
  "api_routes": [
    {
      "method": "POST",
      "path": "/paywalls",
      "export": "create-paywall",
      "auth": "user"
    },
    {
      "method": "PUT",
      "path": "/paywalls/{paywall_id}",
      "export": "update-paywall",
      "auth": "user",
      "path_params": {
        "paywall_id": "paywallId"
      }
    },
    {
      "method": "GET",
      "path": "/paywalls",
      "export": "list-paywalls",
      "auth": "user"
    },
    {
      "method": "DELETE",
      "path": "/paywalls/{paywall_id}",
      "export": "delete-paywall",
      "auth": "user",
      "path_params": {
        "paywall_id": "paywallId"
      }
    },
    {
      "method": "GET",
      "path": "/paywalls/{paywall_id}/payments",
      "export": "list-paywall-payments",
      "auth": "user",
      "path_params": {
        "paywall_id": "paywallId"
      }
    },
    {
      "method": "GET",
      "path": "/wallets",
      "export": "list-wallets",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/currencies",
      "export": "list-currencies",
      "auth": "public"
    },
    {
      "method": "GET",
      "path": "/public/{paywall_id}",
      "export": "get-public-paywall",
      "auth": "public",
      "path_params": {
        "paywall_id": "paywallId"
      }
    },
    {
      "method": "POST",
      "path": "/public/{paywall_id}/invoice",
      "export": "create-paywall-invoice",
      "auth": "public",
      "path_params": {
        "paywall_id": "paywallId"
      },
      "ownerContext": {
        "table": "paywalls",
        "idParam": "paywallId"
      }
    },
    {
      "method": "POST",
      "path": "/public/{paywall_id}/check",
      "export": "check-paywall-payment",
      "auth": "public",
      "path_params": {
        "paywall_id": "paywallId"
      },
      "ownerContext": {
        "table": "paywalls",
        "idParam": "paywallId"
      }
    }
  ],
  "permissions": [
    {
      "id": "ext.storage.read",
      "description": "Read paywalls and paid unlocks in this extension's storage."
    },
    {
      "id": "ext.storage.write",
      "description": "Save paywalls and record paid unlocks."
    },
    {
      "id": "ext.storage.read_public",
      "description": "Show a paywall's title, description and price on its public page. The protected link is never public.",
      "policies": [
        {
          "table_name": "paywalls",
          "public_fields": [
            "id",
            "memo",
            "description",
            "amount",
            "currency",
            "remembers"
          ]
        }
      ]
    },
    {
      "id": "wallet.create_invoice_public",
      "description": "Create invoices into the wallet the paywall owner selected.",
      "policies": [
        {
          "table": "paywalls",
          "wallet_field": "wallet_id"
        }
      ]
    },
    {
      "id": "wallet.list",
      "description": "Show your wallets so you can choose where paywall payments go."
    },
    {
      "id": "utils.basic",
      "description": "List currencies and convert fiat prices to sats."
    }
  ]
}
